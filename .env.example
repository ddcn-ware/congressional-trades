# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# PostgreSQL connection string (Supabase or Neon recommended for free managed Postgres)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Finnhub API key — free tier, 60 calls/min
# Get one at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# Trading 212 read-only API key
# Generate at: Trading 212 app → Settings → API (read-only)
T212_API_KEY=your_t212_api_key_here
